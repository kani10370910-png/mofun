# ============================================================
# MOFUN 魔方智绘平台 · 文案生成 LLM 配置
# 复制本文件为 .env.local 并填入真实值。.env.local 不会进 git / 前端 bundle。
# ============================================================

# provider 预设：deepseek | qwen | glm | ernie | custom
# 选定 provider 后，baseURL 与默认 model 会自动套用，可被下面的变量覆盖。
LLM_PROVIDER=deepseek

# OpenAI 兼容 baseURL（留空则用 provider 预设值）
# deepseek : https://api.deepseek.com/v1
# qwen(通义): https://dashscope.aliyuncs.com/compatible-mode/v1
# glm(智谱) : https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=

# ★ 你的 API Key（必填，绝不要提交到 git）
LLM_API_KEY=

# 模型名（留空则用 provider 预设值，如 deepseek-chat / qwen-plus / glm-4-plus）
LLM_MODEL=

# 上游请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# ============================================================
# 文生图（IP 设计·图片生成）配置 · OpenAI 兼容 /images/generations
# ============================================================
# 图像服务 API Key（必填，绝不要提交到 git）
IMAGE_API_KEY=
# 图像服务 baseURL（OpenAI 兼容），如 AnyFast: https://www.anyfast.ai/v1
IMAGE_BASE_URL=https://www.anyfast.ai/v1
# 图像模型名（留空则用默认）
IMAGE_MODEL=
# 图像请求超时（毫秒，文生图较慢）
IMAGE_TIMEOUT_MS=120000

# ---------- 区县 Lora / 知识库（真实调用）----------
# Qwen 本地文生/图生通道（开 Lora 时 /api/image 会走这里）
COUNTY_IMAGE_MODEL=Qwen-Image-本地-文生图
COUNTY_EDIT_IMAGE_MODEL=Qwen-Image-本地-图生图
# 可选：内部 Lora id → 上游文件名/通道名
# LORA_UPSTREAM_MAP={"lora-anji-tea":"anji_tea.safetensors"}

# ---------- WEKNORA 知识库（腾讯 WeKnora）----------
# 配了 WEKNORA_BASE_URL 后，开启「知识库」会调 /api/v1/knowledge-search
KB_PROVIDER=weknora
WEKNORA_BASE_URL=http://10.0.120.3:81
WEKNORA_API_KEY=
# 区县 regionId / 县名 → WEKNORA 知识库 ID（在后台打开知识库详情可看 id）
# WEKNORA_KB_MAP={"anji":"kb-xxxx","安吉":"kb-xxxx","huzhou":"kb-yyyy"}
# 未匹配到映射时的默认知识库
# WEKNORA_DEFAULT_KB_ID=
# WEKNORA_TIMEOUT_MS=8000
# 未配 WEKNORA 时，仍可用通用远程检索：
# KB_API_URL=
# KB_API_KEY=
# KB_TIMEOUT_MS=8000

# ============================================================
# 数字人模特 · 对口型数字人模型配置
# ============================================================
# 仅使用火山即梦 OmniHuman1.5，不调用 wan2.2。
# —— OmniHuman1.5（火山引擎视觉智能 · AK/SK 签名）——
# 需先在控制台开通「OmniHuman1.5」能力：https://console.volcengine.com/ai/ability/detail/2
# 密钥来自「访问控制 → API 访问密钥 → Access Key（非 API Key）」，需构造请求签名
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
# 提交任务 req_key（一般无需改）
OMNIHUMAN_REQ_KEY=jimeng_realman_avatar_picture_omni_v15
